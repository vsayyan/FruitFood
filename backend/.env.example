# Copy this file to .env and fill in the values. Never commit .env.

SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend addresses allowed to call the API from the browser (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production only (used when DEBUG=False)
# CSRF_TRUSTED_ORIGINS=https://admin.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
